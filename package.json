{
  "name": "pi-supabase-tools",
  "version": "0.3.3",
  "type": "module",
  "description": "Focused Supabase CLI and Edge Function test tools for the Pi coding agent.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "supabase",
    "sandbox",
    "postgres",
    "database"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./config": "./src/config.ts"
  },
  "dependencies": {
    "typebox": "^1.0.0"
  },
  "scripts": {
    "type-check": "tsc",
    "test": "node --import tsx --test src/test/*.test.ts",
    "check": "npm run type-check && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "24.13.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
