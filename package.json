{
  "name": "pi-sandbox-supabase",
  "version": "1.0.0",
  "type": "module",
  "description": "Unsandboxed npx supabase CLI tool for pi coding agent. Provides a supabase_bash tool and /destructive-db slash command with a file-backed destructive-operations gate.",
  "license": "MIT",
  "keywords": ["pi", "pi-extension", "supabase", "sandbox", "postgres", "database"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./tool": "./src/tool.ts",
    "./destructive-gate": "./src/destructive-gate.ts"
  },
  "dependencies": {
    "typebox": "^1.0.0"
  },
  "scripts": {
    "test": "node --import tsx --test src/test/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
